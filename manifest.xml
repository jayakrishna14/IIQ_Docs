<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Plugin PUBLIC "sailpoint.dtd" "sailpoint.dtd">

<Plugin
    name="AutomationLCE"
    displayName="Automation LCE"
    version="1.0.0"
    certificationLevel="None"
    minSystemVersion="8.3">

    <Attributes>
        <Map>

            <!-- Minimum upgradeable version -->
            <entry key="minUpgradableVersion" value="1.0" />

            <!-- Optional full-page definition (can remove if no UI page exists) -->
            <entry key="fullPage">
                <value>
                    <FullPage title="Lifecycle Automation" />
                </value>
            </entry>

            <!-- REST Resource list -->
            <entry key="restResources">
                <value>
                    <List>
                        <!-- Updated to your actual REST class -->
                        <String>com.eshiam.lifecycle.rest.LifecycleResource</String>
                        <String>com.eshiam.lifecycle.rest.TestResource</String>
                    </List>
                </value>
            </entry>

			<entry key="scriptPackages">
				<value>
					<List>
						<String>com.eshiam.lifecycle.rest</String>
					</List>
				</value>
			</entry>

            <!-- Plugin-level settings visible in UI -->
            <entry key="settings">
                <value>
                    <List>
                        <Setting
                            name="joinerRule"
                            label="Joiner Rule Name"
                            dataType="string"
                            defaultValue="LCE_Joiner_Rule"
                            helpText="Rule executed for Joiner events"/>

                        <Setting
                            name="moverRule"
                            label="Mover Rule Name"
                            dataType="string"
                            defaultValue="LCE_Mover_Rule"
                            helpText="Rule executed for Mover events"/>

                        <Setting
                            name="leaverRule"
                            label="Leaver Rule Name"
                            dataType="string"
                            defaultValue="LCE_Leaver_Rule"
                            helpText="Rule executed for Leaver events"/>

                        <Setting
                            name="identityCreationRule"
                            label="identityCreationRule Name"
                            dataType="string"
                            defaultValue="identityCreationRule"
                            helpText="identityCreationRule executed for Joidentity Creation"/>
                        <Setting
                            name="moverWorkflow"
                            label="Mover Workflow Name"
                            dataType="string"
                            defaultValue="LCE_Mover_Workflow"
                            helpText="Workflow executed for Mover events"/>

                        <Setting
                            name="leaverWorkflow"
                            label="Leaver Workflow Name"
                            dataType="string"
                            defaultValue="LCE_Leaver_Workflow"
                            helpText="Workflow executed for Leaver events"/>
                        <Setting
                            name="statusRule"
                            label="Status Rule Name"
                            dataType="string"
                            defaultValue="LCE_Status_Rule"
                            helpText="Rule executed to get status of LCE request"/>
                    </List>
                </value>
            </entry>

        </Map>
    </Attributes>

</Plugin>
