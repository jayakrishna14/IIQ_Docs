<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE sailpoint PUBLIC "sailpoint.dtd" "sailpoint.dtd">

<sailpoint>

  <ImportAction name="merge">
    <Configuration name="SystemConfiguration">
      <Attributes>
        <Map>
          <entry key="quickLinkCategories">
            <value>
              <List>
                <QuickLinkCategory 
                    name="TodoPlugin" 
                    messageKey="todo_plugin_category" 
                    enabled="true" 
                    icon="quickLinkCategoryCustom" />
              </List>
            </value>
          </entry>
        </Map>
      </Attributes>
    </Configuration>
  </ImportAction>

  <QuickLink 
      action="external" 
      category="TodoPlugin" 
      messageKey="todo_plugin_view_db_data" 
      name="ViewTodoList" 
      ordering="4">
      
    <Attributes>
      <Map>
        <entry key="url" value="plugins/rest/TodoPlugin/dbdata"/>
      </Map>
    </Attributes>
    
    <QuickLinkOptions allowSelf="true">
      <DynamicScopeRef>
        <Reference class="sailpoint.object.DynamicScope" name="Everyone"/>
      </DynamicScopeRef>
    </QuickLinkOptions>

  </QuickLink>

</sailpoint>