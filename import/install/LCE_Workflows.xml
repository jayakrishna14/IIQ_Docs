<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sailpoint PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<sailpoint>

<Workflow explicitTransitions="true" libraries="Identity" name="LCE_Joiner_Workflow" type="IdentityLifecycle">
  <Variable name="plan"/>
  <Variable name="flow"/>
  <Variable name="project"/>
  <Variable initializer="false" name="trace"/>
  <Variable name="accountExists"/>
  <Variable name="approvalSet"/>
  <Variable name="emailArgs"/>
  <Variable name="emailArgList"/>
  <Step icon="Start" name="Start">
    <Transition to="Process user"/>
  </Step>
  <Step icon="Message" name="Process user" posX="53" posY="135">
    <Description>Process the user that joined.</Description>
    <Script>
      <Source>
        System.out.println("Processing user: " + identityName);
      </Source>
    </Script>
    <Transition to="Build Plan"/>
  </Step>
  <Step icon="Task" name="Build Plan" posX="162" posY="64" resultVariable="plan">
    <Script>
      <Source>

        System.out.println("Beanshell namespace:");



        for (int i=0; i&lt; this.variables.length; i++){

        String name = this.variables[i];

        if ("transient".equals(name)) { continue; }

        Object value = eval(name);



        if (value == void)

        print("\n"+name + " = void");

        else if (value == null)

        print(name + " = null");

        else

        print ("\n"+name + ":" + value.getClass().getSimpleName() + " = " + value);

        }



        System.out.println("obj..............."+identityObject);

        System.out.println("View PLAN " + plan);
        if(null!=plan)print(plan.toXml());
        return plan;

      </Source>
    </Script>
    <Transition to="end"/>
  </Step>
  <Step icon="Task" name="Initialize" posX="266" posY="9">
    <Arg name="plan" value="ref:plan"/>
    <Arg name="flow" value="ref:flow"/>
    <Arg name="identityName" value="ref:identityName"/>
    <WorkflowRef>
      <Reference class="sailpoint.object.Workflow" id="" name="LCM Provisioning"/>
    </WorkflowRef>
    <Transition to="end"/>
  </Step>
  <Step icon="Stop" name="end" posX="948" posY="15"/>
</Workflow>


