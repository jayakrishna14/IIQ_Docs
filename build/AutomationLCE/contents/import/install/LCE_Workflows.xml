         import sailpoint.object.ProvisioningPlan;

         import sailpoint.object.ProvisioningPlan.AccountRequest;

         import sailpoint.object.ProvisioningPlan.AttributeRequest;

         import java.util.List;

         import java.util.ArrayList;

         import sailpoint.object.Application;

         import sailpoint.object.Link;

         ProvisioningPlan plan = new ProvisioningPlan();

         System.out.println("name........."+identityName);

   

         Identity identityObject = context.getObjectByName(Identity.class, identityName);

         System.out.println("obj..............."+identityObject);

    

         List accountRequests = new ArrayList();

         AccountRequest accountRequest = new AccountRequest();

         accountRequest.setOperation(AccountRequest.Operation.Create);

         accountRequest.setApplication("Active Directory");

    

         Link link = identityObject.getLink(context.getObjectByName(Application.class, "HR Feed"));

         String EmpPop = link.getAttribute("EmpPopulationType");

         String Loc = link.getAttribute("LocationID");

         String Comp = link.getAttribute("COmpCode");

         String Auth = link.getAttribute("AuthSource");

            

         System.out.println("POpulation: " +EmpPop);

         System.out.println("COMP:..." +Comp);

         System.out.println("LOC......:" +Loc);

         String DN =xxxxxx;

         String GDN = xxxxxx;

         System.out.println("DN:...." +DN);                                

         accountRequest.add(new AttributeRequest("givenName",event.getObject().getFirstname()));

         accountRequest.add(new AttributeRequest("sn",event.getObject().getLastname()));

         accountRequest.add(new AttributeRequest("distinguishedName",DN));

         accountRequest.add(new AttributeRequest("sAMAccountName",identityName));

         accountRequest.add(new AttributeRequest("primaryGroupDN",GDN));

         accountRequest.add(new AttributeRequest("mail",identityObject.getEmail()));

     

         accountRequest.setNativeIdentity(DN);

         accountRequests.add(accountRequest);

         plan.setAccountRequests(accountRequests);

         plan.setIdentity(identityObject);


         System.out.println("givenName"+event.getObject().getFirstname());

         System.out.println("DN:...." +DN);

         System.out.println("obj..............."+identityObject);

         System.out.println("View PLAN " + plan.toXml());

         return plan;

      </Source>
